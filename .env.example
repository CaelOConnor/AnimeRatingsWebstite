# Database
DB_NAME=
DB_USER=
DB_PASSWORD=

# Test database bootstrap only — used by backend/db/init-test-db.sh to create
# a role dedicated to the test DB (see the project root's .env.test, which is
# what the test suite itself actually connects with; keep these two in sync
# with it). Never reuse the dev DB_USER/DB_PASSWORD above here.
DB_NAME_TEST=
DB_USER_TEST=
DB_PASSWORD_TEST=

# Least-privilege app role for PRODUCTION only — used by
# backend/db/init-app-role.sh to create a role with just SELECT/INSERT/
# UPDATE/DELETE on the app's tables, no DDL/ownership. docker-compose.prod.yml
# points the backend's DB_USER/DB_PASSWORD at these instead of the owner
# credentials above. Dev keeps using DB_USER/DB_PASSWORD (the owner) for
# convenience — only prod needs this split.
DB_APP_USER=
DB_APP_PASSWORD=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# TMDB
TMDB_API_KEY=

# CORS
CORS_ORIGIN=

# Redis
REDIS_URL=
REDIS_PASSWORD=
# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment variables — never commit secrets, use .env.example instead
.env
.env.test
.env.local
.env.*.local

# React / Vite build output
frontend/dist/
frontend/.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
logs/

# Docker — keep docker-compose.yml but ignore local overrides with secrets
docker-compose.override.yml

# Database volumes (local dev)
postgres-data/
redis-data/

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*.swn

# Jenkins (if running locally)
.jenkins/
jenkins_home/

# Docker
.dockerignore

# Coverage / testing
coverage/
.nyc_output/

# Runtime
*.pid
*.seed
*.pid.lock
pids/

# JWT / auth secrets (extra safety net — these should never be committed)
*.pem
*.key
*.cert
*.p12

# Vite cache
.vite/

# TypeScript (if you add it later)
*.tsbuildinfo

# Optional: ESLint cache
.eslintcache

# db commands
commands.md